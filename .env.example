# Copia este archivo a .env (el .env nunca se sube). Lo carga application.properties.

# Base compartida rentamovil con el usuario telemetry_app (rtm-telemetry-gps-db, 03_dcl), nunca sa.
# DATABASE_PASSWORD = el parameter.telemetryAppPassword de rtm-telemetry-gps-db/liquibase.properties
DATABASE_URL=jdbc:sqlserver://localhost:1433;databaseName=rentamovil;encrypt=true;trustServerCertificate=true
DATABASE_USERNAME=telemetry_app
DATABASE_PASSWORD=ChangeMe_TelemetryApp123!

APP_TELEMETRY_GPS_PORT=3005

# Clave PÚBLICA RS256 de iam. Texto base64 del PEM en una sola
# línea. Es la MISMA que APP_IAM_JWT_PUBLIC_KEY del .env de rtm-iam, no una nueva.
APP_TELEMETRY_GPS_JWT_PUBLIC_KEY=

# Clave fija que deben enviar los dispositivos GPS en POST /locations (header X-Device-Api-Key).
# Una sola clave para todos los dispositivos (no hay columna por dispositivo en el modelo de datos).
APP_TELEMETRY_GPS_DEVICE_API_KEY=ChangeMe_DeviceKey123!

# booking-reservation (solo para resolver rentalId -> gpsId al consultar /tracking/*).
# En Docker: http://booking-reservation:3003
BOOKING_URL=http://localhost:3003

# Clave compartida para llamar/validar /internal/** entre microservicios (header X-Internal-Key).
# MISMA clave en booking-reservation, fleet-maintenance, payment-billing y telemetry-gps.
APP_INTERNAL_API_KEY=ChangeMe_InternalKey123!
